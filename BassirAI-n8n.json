    {
      "parameters": {
        "jsCode": "let aiReply = $json.choices[0].message.content;\n\n// Remove Markdown code fences if present\naiReply = aiReply\n  .replace(/^\\s*```(?:json)?\\s*/i, \"\")\n  .replace(/\\s*```\\s*$/i, \"\")\n  .trim();\n\n// Convert AI response into JSON\nconst booking = JSON.parse(aiReply);\n\n// Get the original message\nconst original = $('Normalize Incoming Message').first().json;\n\nreturn [\n  {\n    json: {\n      patient: original.patient,\n      conversation: original.conversation,\n      booking: booking\n    }\n  }\n];"
      },
