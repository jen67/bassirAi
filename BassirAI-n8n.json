    {
      "parameters": {
        "jsCode": "const aiResponse = $json.choices[0].message.content;\n\nconst text = aiResponse.toLowerCase().trim();\n\nlet intent = null;\n\nif (text.includes('booking')) {\n  intent = 'booking';\n} else if (text.includes('faq')) {\n  intent = 'faq';\n} else if (text.includes('greeting')) {\n  intent = 'greeting';\n} else if (text.includes('complaint')) {\n  intent = 'complaint';\n} else if (text.includes('human support')) {\n  intent = 'human_support';\n}\n\nreturn [\n  {\n    json: {\n      intent: intent,\n      ai_response: aiResponse,\n      patient: $('Normalize Incoming Message').first().json.patient,\n      conversation: $('Normalize Incoming Message').first().json.conversation\n    }\n  }\n];"
      },
