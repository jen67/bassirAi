        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\nbody{\nfont-family:Arial,Helvetica,sans-serif;\nbackground:#f4f4f4;\npadding:20px;\n}\n\n.container{\nbackground:#ffffff;\npadding:30px;\nborder-radius:10px;\nmax-width:700px;\nmargin:auto;\n}\n\nh2{\ncolor:#0B5ED7;\n}\n\ntable{\nwidth:100%;\nborder-collapse:collapse;\nmargin-top:20px;\n}\n\ntd{\npadding:10px;\nborder:1px solid #ddd;\n}\n\n.label{\nfont-weight:bold;\nbackground:#f8f8f8;\nwidth:35%;\n}\n\n.footer{\nmargin-top:30px;\nfont-size:13px;\ncolor:#777;\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"container\">\n\n<h2>New Booking Requires Manual Review</h2>\n\n<p>\nBassirAI has detected a booking request that requires human attention.\nPlease review the details below.\n</p>\n\n<table>\n\n<tr>\n<td class=\"label\">Patient Name</td>\n<td>{{ $('Normalize Incoming Message').first().json.patient.name }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Phone</td>\n<td>{{ $('Normalize Incoming Message').first().json.patient.phone }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Requested Service</td>\n<td>{{ $json.booking.service }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Preferred Date</td>\n<td>{{ $json.booking.preferred_date }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Preferred Time</td>\n<td>{{ $json.booking.preferred_time }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Doctor</td>\n<td>{{ $json.booking.doctor }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Clinic Location</td>\n<td>{{ $json.booking.clinic_location }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Language</td>\n<td>{{ $json.booking.language }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Notes</td>\n<td>{{ $json.booking.notes }}</td>\n</tr>\n\n<tr>\n<td class=\"label\">Needs Human Review</td>\n<td>{{ $json.booking.needs_human }}</td>\n</tr>\n\n</table>\n\n<div class=\"footer\">\n\n</div>\n\n</div>\n\n</body>\n\n</html>",
