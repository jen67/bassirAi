      "parameters": {
        "jsCode": "const body = $json.body;\n\nreturn [\n  {\n    json: {\n      patient: {\n        id: body.userId,\n        name: body.name,\n        phone: body.phone,\n      },\n\n      conversation: {\n        channel: body.channel,\n        language: body.language,\n        message: body.message,\n        timestamp: new Date().toISOString()\n      },\n\n      booking: body.Booking || body.booking || \"\",\n      faq: body.FAQ || body.faq || \"\",\n      greeting: body.Greeting || body.greeting || \"\",\n      complaint: body.Complaint || body.complaint || \"\",\n      human_support: body[\"Human Support\"] || body.human_support || \"\"\n    }\n  }\n];"
      },
