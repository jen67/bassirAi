# .env.example
# BassirAI Backend & Automation Configuration Variables

# 1. Database Configurations
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=bassirai_dev
DB_PORT=5432

# 2. Supabase Integration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-private-key

# 3. OpenAI Embeddings (Used by Teammate's RAG loaders)
OPENAI_API_KEY=sk-proj-yourOpenAiApiKeyForEmbeddings

# 4. Pinecone Vector DB (Used by Teammate's RAG indexer)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=bassirai-index

# 5. Groq Llama API (AI Responder inference)
GROQ_API_KEY=gsk_yourGroqApiKeyHere

# 6. WhatsApp Cloud API Sandbox / Production credentials
WHATSAPP_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-id

# 7. n8n Host settings
N8N_ENCRYPTION_KEY=generate_a_random_secure_string_here
N8N_HOST=localhost
